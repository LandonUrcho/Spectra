# Spectra environment variables. None are needed for local development: leaving a
# variable empty (or unset) gives the default described next to it.
#
# On Vercel, set each variable on the project named in its section, then redeploy.
# Locally, the backend reads the real environment (it doesn't load .env files), and the
# frontend reads cve-frontend/.env.local (gitignored).

# --- Backend: Vercel project with Root Directory cve-backend ------------------

# Extra CORS origins, comma-separated and exact, e.g. https://spectra-frontend.vercel.app
# http://localhost:5173 and http://127.0.0.1:5173 are always allowed. Values are
# lowercased and trailing slashes are stripped.
ALLOWED_ORIGINS=

# Optional regex for Vercel preview URLs, e.g.
#   https://spectra-frontend-[a-z0-9-]+-myteam\.vercel\.app
# Anchor it on your team slug: anyone can claim a "spectra-*.vercel.app" project name.
# An invalid pattern stops the backend from starting, with an error naming the problem.
ALLOWED_ORIGIN_REGEX=

# Optional. Requests per minute per client IP on the vendor routes (default 60); 0 turns the
# limit off. Over the limit the API answers 429 with a Retry-After header.
RATE_LIMIT_PER_MINUTE=

# Optional. Log level for the backend's JSON logs: DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=

# Optional. The CIRCL Vulnerability-Lookup API to query. Defaults to
# https://vulnerability.circl.lu/api; point it at a mirror or a local instance if needed.
CIRCL_BASE_URL=

# --- Frontend: Vercel project with Root Directory cve-frontend ----------------

# Backend base URL, e.g. https://cve-backend.vercel.app (trailing slashes are stripped).
# It's baked in at build time, so redeploy after changing it. When empty, `npm run dev`
# uses http://localhost:8000 and a production build shows a "no API URL" error.
VITE_API_URL=
